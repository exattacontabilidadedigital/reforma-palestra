# Copie este arquivo para .env no VPS e preencha os dois valores.
#   cp .env.example .env && nano .env
# O .env não vai para o Git (está no .gitignore).

# Domínio (ou subdomínio) que já aponta para o IP do VPS.
# Sem http:// e sem barra no fim.
DOMINIO=palestra.exattacontabilidade.com.br

# E-mail para os avisos de expiração de certificado do Let's Encrypt.
EMAIL_TLS=contato@exattacontabilidade.com.br
