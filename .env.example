# Copie este arquivo para .env no VPS e preencha os valores.
#   cp .env.example .env && nano .env
# O .env não vai para o Git (está no .gitignore).

# Domínio (ou subdomínio) que já aponta para o IP do VPS.
# Sem http:// e sem barra no fim.
# Para testar por IP antes de ter domínio, use:  DOMINIO=:80
DOMINIO=palestra.exattacontabilidade.com.br

# Senha para baixar a lista de inscritos em CSV. Gere uma aleatória:
#   openssl rand -hex 24
# Depois é só abrir no navegador:
#   https://SEU-DOMINIO/api/inscricoes.csv?token=O-VALOR-DAQUI
# Deixar em branco desativa a exportação (as inscrições continuam sendo gravadas).
TOKEN_ADMIN=
