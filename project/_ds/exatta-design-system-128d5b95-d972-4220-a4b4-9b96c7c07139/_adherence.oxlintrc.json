        "message": "<NotificationItem> doesn't accept that prop. Declared props: id."
      },
      {
        "selector": "JSXOpeningElement[name.name='Progress'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|tone|showLabel|label|size|style|key|ref|className|style|children)$/]",
        "message": "<Progress> doesn't accept that prop. Declared props: value, tone, showLabel, label, size, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Progress'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:brand|positive|warning|negative|highlight)$/]",
        "message": "<Progress> tone must be one of 'brand' | 'positive' | 'warning' | 'negative' | 'highlight'."
